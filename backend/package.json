    "esbuild": "^0.21.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "grammy": "^1.21.1",
    "prisma": "^5.22.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
